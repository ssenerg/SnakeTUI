[Unit]
Description=SnakeTUI's quick-play queue for a cluster of servers
Documentation=https://github.com/ssenerg/game/blob/main/deploy/CLUSTER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snaketui
Group=snaketui
# Reads the [cluster] table of the servers' settings.
ExecStart=/usr/local/bin/snaketui-matchmaker --config /etc/snaketui/server.toml
Environment=RUST_LOG=info
Restart=always
RestartSec=2
ConfigurationDirectory=snaketui

# It needs nothing but the network.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
