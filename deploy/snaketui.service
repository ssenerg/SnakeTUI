[Unit]
Description=SnakeTUI over SSH
Documentation=https://github.com/ssenerg/SnakeTUI/blob/main/deploy/INSTALL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snaketui
Group=snaketui
ExecStart=/usr/local/bin/snaketui-server --config /etc/snaketui/server.toml
Environment=RUST_LOG=info
Restart=always
RestartSec=2
# SIGTERM makes the server tell players it's restarting and close cleanly.
KillSignal=SIGTERM
TimeoutStopSec=10
LimitNOFILE=65536

# The only privilege it gets: listening on port 22.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Host key and database live in /var/lib/snaketui, owned by the service user.
StateDirectory=snaketui
StateDirectoryMode=0700
ConfigurationDirectory=snaketui
UMask=0077

# Everything else is read-only or hidden.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
